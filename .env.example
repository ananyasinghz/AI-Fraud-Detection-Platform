FRAUD_APP_NAME=Suspicious Activity Detection API
FRAUD_APP_VERSION=0.1.0
FRAUD_ENVIRONMENT=development
FRAUD_DEBUG=false
FRAUD_LOG_LEVEL=INFO
FRAUD_API_PREFIX=/api/v1
FRAUD_DATABASE_URL=sqlite:///./data/processed/fraud.db
FRAUD_DATA_DIR=data
FRAUD_MODEL_DIR=models
FRAUD_POLICY_CONFIG_PATH=config/policy/reporting_thresholds.v1.yaml
FRAUD_SCENARIO_CONFIG_PATH=config/generation/scenario_catalog.v1.yaml
FRAUD_RAW_CREDITCARD_PATH=dataset/creditcard.csv
FRAUD_DEVELOPMENT_SEED=42
FRAUD_HELDOUT_SEED=99
FRAUD_ML_ENABLED=true
FRAUD_ML_MODEL_DIR=models/ulb_v1/selected
# Demo default: deterministic intent/planner/explanation (no local LLM required).
FRAUD_OLLAMA_ENABLED=false
FRAUD_PLANNER_ENABLED=false
FRAUD_RISK_ENABLED=true
FRAUD_EXPLANATION_ENABLED=true
# Optional absolute API base for the React app; leave empty to use Vite `/api` proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000
